# Copy to .env and edit. Never commit .env.

# Set to TRUE only after reading Mojang's EULA: https://aka.ms/MinecraftEULA
EULA=FALSE

# Minecraft names (comma separated). Only these can join; OPS can run the /unseen commands.
WHITELIST=
OPS=

MEMORY=4G

# ---- Optional voice cloning (phrases nobody said). Leave these three commented out to only replay recorded clips.
# COMPOSE_PROFILES=voice
# UNSEEN_VOICE_URL=http://voicestudio:3900
# Make a long random key, for example:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# UNSEEN_VOICE_API_KEY=
# VOICE_THREADS=4
